### slope
hours = df["hours"]
before = mean_squared_error(y, 8 * hours + 35)
after = mean_squared_error(y, 8.001 * hours + 35)
change = after - before
print("MSE 변화:", round(change, 4))
print("변화 ÷ 0.001:", round(change / 0.001, 1))
--- output
MSE 변화: -0.044
변화 ÷ 0.001: -44.0

### sgd
sgd = SGDRegressor(
    loss="squared_error",
    learning_rate="constant",
    eta0=0.01,
    max_iter=1000,
    shuffle=False,
    random_state=42
)
--- output


### loop
history = []
for epoch in range(1000):
    sgd.partial_fit(X, y)
    y_pred = sgd.predict(X)
    history.append({
        "epoch": epoch + 1,
        "weight": sgd.coef_[0],
        "bias": sgd.intercept_[0],
        "mse": mean_squared_error(y, y_pred)
    })
history_df = pd.DataFrame(history)
history_df[history_df["epoch"].isin([1, 5, 10, 100, 500, 1000])]
--- output
