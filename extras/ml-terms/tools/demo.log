### eta
for eta in [0.001, 0.01, 0.3]:
    s = SGDRegressor(learning_rate="constant", eta0=eta,
                     shuffle=False, random_state=42)
    for epoch in range(1000):
        s.partial_fit(X, y)
    print(eta, mean_squared_error(y, s.predict(X)))
